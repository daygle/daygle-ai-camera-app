<?xml version="1.0" encoding="utf-8"?>
<!--
  PlayerView backed by a TextureView so the video surface can be transformed
  (scaled/translated) for pinch-to-zoom. A SurfaceView (the default) renders on a
  separate window and does not follow view/graphicsLayer transforms.
-->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/player_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:resize_mode="fit"
    app:surface_type="texture_view"
    app:use_controller="true" />
