<?xml version="1.0" encoding="utf-8"?>
<!--
  Daygle AI Camera is commonly self-hosted on a LAN address over plain HTTP
  (e.g. http://192.168.1.20:8080). Cleartext traffic is therefore permitted so
  users can connect to a local server. HTTPS is always preferred when the
  server is reachable over TLS; only enable cleartext for hosts you trust.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
