    <!-- These two only report that a newer release of Gradle, AGP or a library exists.
         They react to upstream releases rather than to this repository, so with
         warningsAsErrors a single patch release upstream would turn every build red
         without a line of code changing. Dependabot (.github/dependabot.yml) opens the
         upgrade pull requests weekly, so the notices stay in the lint report as
         informational, and real code warnings still fail the build. -->
    <issue id="AndroidGradlePluginVersion" severity="informational" />
    <issue id="GradleDependency" severity="informational" />
</lint>
